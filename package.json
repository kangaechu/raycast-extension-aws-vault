{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "raycast-extension-aws-vault",
  "title": "raycast-extension-aws-vault",
  "description": "Extension for Raycast which opens the AWS management console via aws-vault.",
  "icon": "command-icon.png",
  "author": "sawadashota",
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "aws-vault",
      "description": "Opens the AWS management console via aws-vault",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "title": "Browser",
      "data": [
        {
          "title": "Google Chrome",
          "value": "Google Chrome"
        },
        {
          "title": "firefox",
          "value": "firefox"
        },
        {
          "title": "Brave Browser",
          "value": "Brave Browser"
        }
      ],
      "default": "Google Chrome",
      "name": "browserName",
      "description": "Which browser to use.",
      "type": "dropdown",
      "required": true
    },
    {
      "title": "aws-vault entrypoint",
      "default": "aws-vault",
      "name": "entrypoint",
      "description": "Entrypoint of aws-vault command. If default doesn't work, please set path to aws-vault.",
      "type": "textfield",
      "required": true
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.7.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^22.19.17",
    "@types/react": "^19.0.10",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "react-devtools": "^6.1.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint"
  },
  "version": "0.2.0"
}
